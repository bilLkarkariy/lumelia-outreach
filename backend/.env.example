# Copy to backend/.env. Every value here is a placeholder. The API does not start without a
# password hash; production also requires the encryption key and secure cookies.

# --- Core -----------------------------------------------------------------------------------
LUMELIA_DATABASE_URL=postgresql+psycopg://lumelia:CHANGE_ME@127.0.0.1:5432/lumelia
# Fernet key that encrypts stored provider credentials, mailbox passwords and call audio:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LUMELIA_ENCRYPTION_KEY=
# Argon2 hash of the workspace password. Written by: uv run python scripts/set_access_password.py
LUMELIA_ACCESS_PASSWORD_HASH=
LUMELIA_ENVIRONMENT=development
# Origins allowed to call the API with credentials (comma-separated).
LUMELIA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000
# Public base URL, used in unsubscribe links and provider callbacks. Live sending requires https.
LUMELIA_PUBLIC_URL=http://127.0.0.1:8000
# Set to true behind TLS so the session cookie is only sent over https.
LUMELIA_COOKIE_SECURE=false
LUMELIA_SESSION_HOURS=12
LUMELIA_WORKER_INTERVAL_SECONDS=10

# --- Safety switches ------------------------------------------------------------------------
# Master switch for anything that reaches a third party: SMTP sends, paid enrichment, calls.
# While false, campaigns can only run in simulation.
LUMELIA_LIVE_ACTIONS_ENABLED=false
# Demo switch: the worker skips every job that opens a connection (mailbox checks, IMAP
# collection, warm-up, sourcing, call reconciliation).
LUMELIA_OFFLINE=false

# --- Recipient notice and sender protection -------------------------------------------------
# Shown on the public /privacy page linked from every email.
LUMELIA_COMPANY_NAME=Example Company
LUMELIA_PRIVACY_CONTACT=privacy@example.com
# Domains and addresses that must never send cold email (comma-separated), typically the
# company's primary domain. Subdomains are covered.
LUMELIA_PROTECTED_SENDER_DOMAINS=
LUMELIA_PROTECTED_SENDER_ADDRESSES=

# --- Calls (optional) -----------------------------------------------------------------------
# Leave empty to disable browser and mobile calling.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
# Number presented to the person called. The default sits in the range reserved for fiction.
TWILIO_CALLER_ID=+33199000010
# Operator's own verified mobile for call bridging; must differ from the caller ID.
TWILIO_OPERATOR_NUMBER=
TWILIO_INBOUND_ENABLED=false
# Transcription of recorded calls.
DEEPGRAM_API_KEY=
# Encrypted call audio: a local directory, or an S3-compatible bucket when AWS_* is set.
CALLS_MEDIA_ROOT=runtime/private-call-audio
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
AWS_DEFAULT_REGION=auto

# Provider API keys (Hunter, FullEnrich, Apollo, lemlist, Apify) and mailbox credentials are not
# environment variables: they are entered in Settings and stored encrypted in the database.
# The agent runner has its own variables, documented in docs/AGENT.md.
