{
  "$defs": {
    "AccountReview": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "title": "Account Id",
          "type": "string"
        },
        "decision": {
          "default": "exploratory",
          "enum": [
            "fit",
            "exploratory",
            "not_fit"
          ],
          "title": "Decision",
          "type": "string"
        },
        "business_type": {
          "default": "unknown",
          "enum": [
            "b2b",
            "b2c",
            "unknown"
          ],
          "title": "Business Type",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 10,
          "title": "Summary",
          "type": "string"
        },
        "proofs": {
          "items": {
            "$ref": "#/$defs/Proof"
          },
          "maxItems": 10,
          "title": "Proofs",
          "type": "array"
        },
        "leads": {
          "items": {
            "$ref": "#/$defs/Lead"
          },
          "maxItems": 3,
          "title": "Leads",
          "type": "array"
        },
        "account_updates": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccountUpdate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "account_id",
        "summary"
      ],
      "title": "AccountReview",
      "type": "object"
    },
    "AccountUpdate": {
      "additionalProperties": false,
      "properties": {
        "employee_count": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Employee Count"
        },
        "hubspot_status": {
          "default": "",
          "enum": [
            "",
            "confirmed",
            "absent"
          ],
          "title": "Hubspot Status",
          "type": "string"
        }
      },
      "title": "AccountUpdate",
      "type": "object"
    },
    "BusinessResult": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "default": "",
          "maxLength": 500,
          "title": "Subject",
          "type": "string"
        },
        "body": {
          "default": "",
          "maxLength": 20000,
          "title": "Body",
          "type": "string"
        },
        "name": {
          "default": "",
          "maxLength": 180,
          "title": "Name",
          "type": "string"
        },
        "sequence": {
          "items": {
            "$ref": "#/$defs/SequenceStep"
          },
          "maxItems": 10,
          "title": "Sequence",
          "type": "array"
        }
      },
      "title": "BusinessResult",
      "type": "object"
    },
    "CallAction": {
      "additionalProperties": false,
      "properties": {
        "source_action_id": {
          "anyOf": [
            {
              "maxLength": 36,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Action Id"
        },
        "kind": {
          "enum": [
            "callback",
            "draft_email",
            "identify",
            "qualify",
            "assign_contact",
            "update_opportunity",
            "human_decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "maxLength": 220,
          "minLength": 5,
          "title": "Title",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 5,
          "title": "Reason",
          "type": "string"
        },
        "segment_index": {
          "minimum": 0,
          "title": "Segment Index",
          "type": "integer"
        },
        "quote": {
          "maxLength": 3000,
          "minLength": 5,
          "title": "Quote",
          "type": "string"
        },
        "due_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due At"
        },
        "depends_on": {
          "items": {
            "type": "integer"
          },
          "maxItems": 30,
          "title": "Depends On",
          "type": "array"
        },
        "requires_decision": {
          "default": false,
          "title": "Requires Decision",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "title",
        "reason",
        "segment_index",
        "quote"
      ],
      "title": "CallAction",
      "type": "object"
    },
    "ContactUpdate": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "anyOf": [
            {
              "format": "email",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "phone": {
          "default": "",
          "maxLength": 50,
          "title": "Phone",
          "type": "string"
        },
        "linkedin_url": {
          "default": "",
          "maxLength": 600,
          "title": "Linkedin Url",
          "type": "string"
        },
        "role": {
          "default": "",
          "maxLength": 180,
          "title": "Role",
          "type": "string"
        }
      },
      "title": "ContactUpdate",
      "type": "object"
    },
    "IdentifiedPerson": {
      "additionalProperties": false,
      "properties": {
        "first_name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "First Name",
          "type": "string"
        },
        "last_name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Last Name",
          "type": "string"
        },
        "role": {
          "maxLength": 180,
          "minLength": 2,
          "title": "Role",
          "type": "string"
        },
        "email": {
          "default": "",
          "maxLength": 320,
          "title": "Email",
          "type": "string"
        },
        "segment_index": {
          "minimum": 0,
          "title": "Segment Index",
          "type": "integer"
        },
        "quote": {
          "maxLength": 3000,
          "minLength": 5,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "first_name",
        "last_name",
        "role",
        "segment_index",
        "quote"
      ],
      "title": "IdentifiedPerson",
      "type": "object"
    },
    "Lead": {
      "additionalProperties": false,
      "properties": {
        "company": {
          "maxLength": 220,
          "minLength": 2,
          "title": "Company",
          "type": "string"
        },
        "domain": {
          "maxLength": 253,
          "minLength": 3,
          "title": "Domain",
          "type": "string"
        },
        "country": {
          "const": "FR",
          "default": "FR",
          "title": "Country",
          "type": "string"
        },
        "industry": {
          "maxLength": 180,
          "minLength": 3,
          "title": "Industry",
          "type": "string"
        },
        "first_name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "First Name",
          "type": "string"
        },
        "last_name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Last Name",
          "type": "string"
        },
        "role": {
          "maxLength": 180,
          "minLength": 3,
          "title": "Role",
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "format": "email",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "phone": {
          "default": "",
          "maxLength": 50,
          "title": "Phone",
          "type": "string"
        },
        "phone_type": {
          "default": "unknown",
          "enum": [
            "unknown",
            "direct",
            "switchboard"
          ],
          "title": "Phone Type",
          "type": "string"
        },
        "linkedin_url": {
          "default": "",
          "maxLength": 600,
          "title": "Linkedin Url",
          "type": "string"
        },
        "relevance": {
          "maxLength": 2000,
          "minLength": 30,
          "title": "Relevance",
          "type": "string"
        },
        "next_action": {
          "maxLength": 1000,
          "minLength": 10,
          "title": "Next Action",
          "type": "string"
        },
        "proofs": {
          "items": {
            "$ref": "#/$defs/Proof"
          },
          "maxItems": 10,
          "minItems": 2,
          "title": "Proofs",
          "type": "array"
        }
      },
      "required": [
        "company",
        "domain",
        "industry",
        "first_name",
        "last_name",
        "role",
        "relevance",
        "next_action",
        "proofs"
      ],
      "title": "Lead",
      "type": "object"
    },
    "Proof": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "identity",
            "role",
            "industry",
            "employee_count",
            "hubspot_status",
            "email",
            "phone",
            "linkedin_url",
            "relevance",
            "research",
            "b2b"
          ],
          "title": "Field",
          "type": "string"
        },
        "value": {
          "maxLength": 4000,
          "minLength": 2,
          "title": "Value",
          "type": "string"
        },
        "source_url": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Source Url",
          "type": "string"
        },
        "excerpt": {
          "maxLength": 1600,
          "minLength": 10,
          "title": "Excerpt",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "field",
        "value",
        "source_url",
        "excerpt",
        "observed_at"
      ],
      "title": "Proof",
      "type": "object"
    },
    "ReportInput": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "maxLength": 20000,
          "minLength": 10,
          "title": "Summary",
          "type": "string"
        },
        "needs": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Needs",
          "type": "array"
        },
        "objections": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Objections",
          "type": "array"
        },
        "commitments": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Commitments",
          "type": "array"
        },
        "uncertainties": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Uncertainties",
          "type": "array"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/CallAction"
          },
          "maxItems": 30,
          "title": "Actions",
          "type": "array"
        },
        "identified_person": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdentifiedPerson"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome": {
          "default": "conversation",
          "enum": [
            "conversation",
            "interested",
            "no_need",
            "not_reached",
            "wrong_number",
            "stop"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "outcome_segment_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome Segment Index"
        },
        "outcome_quote": {
          "default": "",
          "maxLength": 3000,
          "title": "Outcome Quote",
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
      "title": "ReportInput",
      "type": "object"
    },
    "SequenceStep": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "email",
            "phone",
            "linkedin"
          ],
          "title": "Channel",
          "type": "string"
        },
        "day": {
          "maximum": 180,
          "minimum": 0,
          "title": "Day",
          "type": "integer"
        },
        "subject": {
          "default": "",
          "maxLength": 500,
          "title": "Subject",
          "type": "string"
        },
        "body": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "day",
        "body"
      ],
      "title": "SequenceStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "post_call_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReportInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "business_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/BusinessResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "account_reviews": {
      "items": {
        "$ref": "#/$defs/AccountReview"
      },
      "maxItems": 10,
      "title": "Account Reviews",
      "type": "array"
    },
    "outcome": {
      "enum": [
        "completed",
        "waiting_human",
        "retry"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "summary": {
      "maxLength": 3000,
      "minLength": 10,
      "title": "Summary",
      "type": "string"
    },
    "human_reason": {
      "default": "",
      "maxLength": 2000,
      "title": "Human Reason",
      "type": "string"
    },
    "human_category": {
      "default": "",
      "enum": [
        "",
        "private_access",
        "commercial_commitment",
        "legal_decision",
        "manual_channel"
      ],
      "title": "Human Category",
      "type": "string"
    },
    "retry_minutes": {
      "default": 15,
      "maximum": 1440,
      "minimum": 2,
      "title": "Retry Minutes",
      "type": "integer"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "proofs": {
      "items": {
        "$ref": "#/$defs/Proof"
      },
      "maxItems": 15,
      "title": "Proofs",
      "type": "array"
    },
    "leads": {
      "items": {
        "$ref": "#/$defs/Lead"
      },
      "maxItems": 5,
      "title": "Leads",
      "type": "array"
    },
    "relevance": {
      "default": "",
      "maxLength": 2000,
      "title": "Relevance",
      "type": "string"
    },
    "decision": {
      "default": "exploratory",
      "enum": [
        "fit",
        "exploratory",
        "not_fit"
      ],
      "title": "Decision",
      "type": "string"
    },
    "next_action": {
      "default": "",
      "maxLength": 1500,
      "title": "Next Action",
      "type": "string"
    },
    "contact_updates": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContactUpdate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "account_updates": {
      "anyOf": [
        {
          "$ref": "#/$defs/AccountUpdate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reply_subject": {
      "default": "",
      "maxLength": 500,
      "title": "Reply Subject",
      "type": "string"
    },
    "reply_body": {
      "default": "",
      "maxLength": 20000,
      "title": "Reply Body",
      "type": "string"
    }
  },
  "required": [
    "outcome",
    "summary",
    "request_id"
  ],
  "title": "AgentResult",
  "type": "object"
}
